# Terranet lab environment - SYNTHETIC DEV VALUES ONLY. Copy to .env (gitignored) via `./lab.sh init`.
# Never reuse production values here. Nothing in this file points to a production system.
SECRET_KEY_BASE=__GENERATED_BY_LAB_SH__
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=__GENERATED_BY_LAB_SH__
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=__GENERATED_BY_LAB_SH__
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=__GENERATED_BY_LAB_SH__
POSTGRES_PASSWORD=__GENERATED_BY_LAB_SH__
REDIS_PASSWORD=__GENERATED_BY_LAB_SH__

LAB_RAILS_PORT=13000
LAB_VITE_PORT=3036
LAB_MAILPIT_PORT=18025

FRONTEND_URL=http://localhost:13000
RAILS_ENV=development
NODE_ENV=development
INSTALLATION_ENV=terranet-lab
ENABLE_ACCOUNT_SIGNUP=false
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
REDIS_URL=redis://redis:6379

MAILER_SENDER_EMAIL=Terranet Lab <lab@terranet.invalid>
SMTP_ADDRESS=mailpit
SMTP_PORT=1025
SMTP_DOMAIN=terranet.invalid
SMTP_ENABLE_STARTTLS_AUTO=false

ACTIVE_STORAGE_SERVICE=local

# Privacy controls under test (see docs/terranet/03-privacy-egress-audit.md)
DISABLE_TELEMETRY=true
ENABLE_PUSH_RELAY_SERVER=false


# annotate_rb (lib/tasks/annotate_rb.rake) rewrites tracked models after db tasks unless this is set
ANNOTATERB_SKIP_ON_DB_TASKS=1

# Terranet decision (Camino B): Community Edition only. enterprise/ is present on disk but never activated.
DISABLE_ENTERPRISE=true
# Terranet privacy mode (lib/terranet/privacy.rb): no Chatwoot hub, no push relay calls, no external avatar fetch
TERRANET_PRIVACY_MODE=true
# Supported upstream switch that stops server-side Gravatar lookups (sends md5(email) to gravatar.com otherwise)
DISABLE_GRAVATAR=1

# avoids 'Channel email domain not present' noise when the seed conversation triggers a reply email
MAILER_INBOUND_EMAIL_DOMAIN=terranet.invalid
