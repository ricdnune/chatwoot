#!/usr/bin/env bash
# Pre-push: scan every commit about to leave this machine. Install with terranet/tools/install_hooks.sh
set -euo pipefail
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a ref: nothing to scan
  if [ "$remote_sha" = "$zero" ]; then range=("$local_sha" --not --remotes); else range=("$remote_sha..$local_sha"); fi
  "$(git rev-parse --show-toplevel)/terranet/tools/secret_scan.sh" "${range[@]}" || { echo "pre-push: blocked $local_ref" >&2; exit 1; }
done
